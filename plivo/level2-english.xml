<?xml version="1.0" encoding="UTF-8"?>
<!--
  IVR Level 2: English Menu
  
  This XML demonstrates the structure of the English menu.
  The actual XML is generated dynamically by routes/ivr.js
  
  Flow:
  - Prompts caller to select an option
  - 1 = Play sample audio
  - 2 = Forward to representative
  - Invalid input → Redirects back to Level 2 English
-->
<Response>
    <GetDigits 
        action="http://your-domain.com/ivr/level2-english" 
        method="POST" 
        timeout="5" 
        numDigits="1" 
        retries="1"
        redirect="false">
        <Speak>
            English menu.
            Press 1 to play a sample audio.
            Press 2 to speak with a representative.
        </Speak>
    </GetDigits>
    
    <!-- If no input received, prompt again -->
    <Speak>
        We did not receive your input. Please try again.
    </Speak>
    <Redirect>http://your-domain.com/ivr/level2-english</Redirect>
</Response>

