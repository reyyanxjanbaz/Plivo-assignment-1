<?xml version="1.0" encoding="UTF-8"?>
<!--
  IVR Level 2: English Menu (Reference)
-->
<Response>
    <GetDigits 
        action="http://your-app-url.com/ivr/level2/english" 
        method="POST" 
        timeout="7" 
        numDigits="1" 
        retries="1"
        redirect="false">
        <Speak language="en-US" voice="WOMAN">
            English menu. 
            Press 1 to hear a message. 
            Press 2 to talk to an associate.
        </Speak>
    </GetDigits>
    
    <!-- Timeout / No Input Handler -->
    <Speak language="en-US" voice="WOMAN">
        We did not receive your input. Invalid selection.
    </Speak>
    <Redirect>http://your-app-url.com/ivr/level2/english</Redirect>
</Response>
