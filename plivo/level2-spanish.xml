<?xml version="1.0" encoding="UTF-8"?>
<!--
  IVR Level 2: Spanish Menu
  
  This XML demonstrates the structure of the Spanish menu.
  The actual XML is generated dynamically by routes/ivr.js
  
  Flow:
  - Prompts caller to select an option (in Spanish)
  - 1 = Play sample audio
  - 2 = Forward to representative
  - Invalid input → Redirects back to Level 2 Spanish
-->
<Response>
    <GetDigits 
        action="http://your-domain.com/ivr/level2-spanish" 
        method="POST" 
        timeout="5" 
        numDigits="1" 
        retries="1"
        redirect="false">
        <Speak language="es-ES">
            Menú en español.
            Presione 1 para escuchar un audio de muestra.
            Presione 2 para hablar con un representante.
        </Speak>
    </GetDigits>
    
    <!-- If no input received, prompt again -->
    <Speak language="es-ES">
        No recibimos su entrada. Por favor intente de nuevo.
    </Speak>
    <Redirect>http://your-domain.com/ivr/level2-spanish</Redirect>
</Response>

